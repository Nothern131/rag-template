# 复制为 .env 并填写
LLM_BACKEND=mock            # openai / anthropic / local / mock
EMBEDDING_BACKEND=local     # local / openai

# OpenAI（若 LLM_BACKEND=openai 或 local）
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434/v1   # 本地 Ollama
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# 检索
TOP_K=5
MIN_SCORE=0.25

# 服务
HOST=0.0.0.0
PORT=8000
